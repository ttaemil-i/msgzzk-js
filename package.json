{
  "name": "msgzzk",
  "version": "1.0.2",
  "description": "unofficial node.js client for receiving live chat messages only from naver chzzk.",
  "keywords": [
    "chzzk",
    "naver",
    "chat",
    "message",
    "live",
    "websocket",
    "nodejs"
  ],
  "author": "ttaemil-i",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc --project tsconfig.json",
    "publish": "npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttaemil-i/msgzzk-js.git"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/ttaemil-i/msgzzk-js/issues"
  },
  "homepage": "https://github.com/ttaemil-i/msgzzk-js#readme",
  "dependencies": {
    "axios": "^1.6.8",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
